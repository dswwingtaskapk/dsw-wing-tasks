rules_version = '2';
// Wing Tasks - who can read and write what.
// Send to Firebase with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && me() == 'dswwingtaskapk@gmail.com'; }
    function memberPath() { return /databases/$(database)/documents/members/$(me()); }
    function isMember() {
      return isAdmin() || (signedIn() && exists(memberPath()) && get(memberPath()).data.get('active', true) != false);
    }
    function reportRole() { return get(memberPath()).data.get('reportRole', 'none'); }
    function canReport() { return isAdmin() || (isMember() && reportRole() != 'none'); }
    function editReport() { return isAdmin() || (isMember() && !(reportRole() in ['none', 'viewer'])); }   // viewers only read
    function cmdtPerson() {
      return isMember() && me() in get(/databases/$(database)/documents/config/commandant).data.get('to', []);
    }
    function onlyCmdt() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['cmdt']);
    }
    function fullReport() { return isAdmin() || (isMember() && reportRole() == 'full'); }
    function involved(d) { return d.assigneeEmail == me() || d.creatorEmail == me() || d.giverEmail == me(); }

    // ---- members (only the Admin adds / edits people) ----
    match /members/{email} {
      allow get: if signedIn() && (email == me() || isMember());
      allow list: if isMember();
      allow write: if isAdmin();
    }

    // ---- tasks + chat files ----
    match /tasks/{taskId} {
      allow read: if isAdmin() || (isMember() && involved(resource.data));
      allow create: if isAdmin() || (isMember() && request.resource.data.creatorEmail == me());
      allow update: if isAdmin() || (isMember() && involved(resource.data));
      allow delete: if isAdmin() || (isMember() && resource.data.creatorEmail == me());

      match /files/{fileId} {
        allow read, write: if isAdmin() ||
          (isMember() && involved(get(/databases/$(database)/documents/tasks/$(taskId)).data));
      }
    }

    // ---- task categories set by the Admin ----
    match /categories/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---- each person's own settings and personal categories ----
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- app settings (report defaults, report format, push server address) ----
    match /config/{name} {
      allow read: if isMember();
      allow write: if isAdmin() || (name == 'dailyReport' && fullReport());
    }

    // ---- daily reports ----
    // Viewers can read everything here; the people who pass the report on to the Commandant
    // can read the report and tick "Done" (the 'cmdt' field) and nothing else.
    match /dailyReports/{date} {
      allow read: if canReport() || cmdtPerson();
      allow create, update: if editReport() || ((canReport() || cmdtPerson()) && onlyCmdt());
      allow delete: if isAdmin();
      match /sections/{section} {
        allow read: if canReport();
        allow create, update: if editReport();
        allow delete: if isAdmin();
      }
    }

    // ---- in-app notifications (bell icon) ----
    match /notifications/{email}/items/{id} {
      allow read, update, delete: if signedIn() && email == me();
      allow create: if isMember();
    }

    // ---- phone push: which phone belongs to whom ----
    match /fcmTokens/{token} {
      allow read, delete: if signedIn() && resource.data.email == me();
      allow create, update: if signedIn() && request.resource.data.email == me();
    }

    // ---- chats ----
    // "wing" = the whole wing. One-to-one chats are named "dm:<email1>:<email2>",
    // so the name itself says who may open it (works even before the first message).
    function inChatName(chatId) { return chatId == 'wing' || (chatId.split(':')[0] == 'dm' && me() in chatId.split(':')); }
    match /chats/{chatId} {
      allow get: if isMember() && inChatName(chatId);
      allow list: if isMember() && me() in resource.data.members;
      allow create, update: if isMember() && inChatName(chatId);
      match /{part}/{id} {
        allow read: if isMember() && inChatName(chatId);
        allow create: if isMember() && inChatName(chatId) && request.resource.data.by == me();
        allow update, delete: if isMember() && (isAdmin() || resource.data.by == me());
      }
    }

    // ---- in-app audio calls (call set-up only; the voice goes phone-to-phone) ----
    function callPath(id) { return /databases/$(database)/documents/calls/$(id); }
    match /calls/{callId} {
      allow create: if isMember() && request.resource.data.from == me();
      allow read, update: if isMember() && (resource.data.from == me() || resource.data.to == me());
      match /{part}/{id} {
        allow read, create: if isMember() && (get(callPath(callId)).data.from == me() || get(callPath(callId)).data.to == me());
      }
    }

    // ---- push messages waiting for the push server ----
    match /pushQueue/{id} {
      allow create: if isMember() && request.resource.data.email is string;
    }
  }
}
